NODE_ENV=production
PORT=5000

# Your deployed frontend origin (no trailing slash). Used for CORS.
CLIENT_URL=https://your-frontend-domain.example.com

MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<db>

# Generate with: openssl rand -hex 32
JWT_SECRET=
JWT_EXPIRY=15m
REFRESH_TOKEN_EXPIRY=7d

# Generate with: openssl rand -hex 32
CSRF_TOKEN_SECRET=

# Must be "true" in production — client and server run on different
# origins, and the CSRF/refresh-token cookies require Secure+SameSite=None
# to be delivered cross-site, which only works over HTTPS.
HTTPS_ONLY=true

LOG_LEVEL=info
