# Server Configuration
NODE_ENV=development
PORT=5000

# Database
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/ledgerHQ

# JWT Configuration
JWT_SECRET=your-secret-key-min-32-characters-long-123456789
JWT_EXPIRY=15m
REFRESH_TOKEN_EXPIRY=7d

# CSRF Protection
CSRF_TOKEN_SECRET=your-csrf-secret-key-min-32-characters-long

# Client Configuration
CLIENT_URL=http://localhost:5173

# Security
HTTPS_ONLY=false

# Logging
LOG_LEVEL=info
