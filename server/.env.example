NODE_ENV=development
PORT=5000

MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/ledgerHQ

JWT_SECRET=your-secret-key-min-32-characters-long-123456789
JWT_EXPIRY=15m
REFRESH_TOKEN_EXPIRY=7d

CSRF_TOKEN_SECRET=your-csrf-secret-key-min-32-characters-long

CLIENT_URL=http://localhost:5173

HTTPS_ONLY=false

LOG_LEVEL=info
